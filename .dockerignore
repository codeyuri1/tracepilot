# Only backend build inputs belong in this context
**
!pom.xml
!mvnw
!.mvn/
!.mvn/**
!src/
!src/**
# Defense in depth for files nested inside source directories
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/credentials.json
**/service-account*.json
**/*.log
**/.DS_Store
